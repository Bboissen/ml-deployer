platform_binding = {
  schema_version                          = "1.0.0"
  provider                                = "gcp"
  project_id                              = "example-project"
  region                                  = "europe-west1"
  state_bucket_name                       = "ml-infra-example-project-gcp-state"
  data_bucket_name                        = "mlinfra-example-project-a1b2c3-data"
  results_bucket_name                     = "mlinfra-example-project-a1b2c3-results"
  artifact_repository_id                  = "mlinfra-runtime"
  artifact_repository_uri                 = "europe-west1-docker.pkg.dev/example-project/mlinfra-runtime"
  network_self_link                       = "https://www.googleapis.com/compute/v1/projects/example-project/global/networks/mlinfra-runner"
  subnetwork_self_link                    = "https://www.googleapis.com/compute/v1/projects/example-project/regions/europe-west1/subnetworks/mlinfra-runner-europe-west1"
  receipt_publisher_service_account_email = "mlinfra-receipt-pub@example-project.iam.gserviceaccount.com"
  workload_results_prefix                 = "runs/"
  reserved_control_prefix                 = "control/"
  bootstrap_log_suffix                    = "/logs/bootstrap.log"
  local_receipt_handoff_suffix            = "/control-input/execution-receipt.local.json"
  interactive_access_enabled              = false
}
