runner_request = {
  schema_version          = "1.0.0"
  deployment_id           = "contract-smoke-001"
  provider                = "gcp"
  oci_repository          = "europe-west1-docker.pkg.dev/example-project/mlinfra-runtime/ml-runner"
  oci_digest              = "sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
  run_spec_uri            = "gs://mlinfra-example-project-a1b2c3-results/run-specs/contract-smoke-001/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.json"
