#!/usr/bin/env bash
set -euo pipefail
umask 077

exec >>/var/log/ml-runner-bootstrap.log 2>&1

decode() {
  printf '%s' "$1" | /usr/bin/base64 --decode
}

readonly AWS_REGION_VALUE="$(decode '${aws_region_base64}')"
readonly DATA_URI="$(decode '${data_uri_base64}')"
readonly DEPLOYMENT_ID="$(decode '${deployment_id_base64}')"
readonly LOG_URI="$(decode '${log_uri_base64}')"
readonly LOCAL_RECEIPT_KEY="$(decode '${local_receipt_key_base64}')"
readonly MAXIMUM_RUNTIME_MINUTES="$(decode '${maximum_runtime_minutes_base64}')"
readonly OCI_DIGEST="$(decode '${oci_digest_base64}')"
readonly OCI_REPOSITORY="$(decode '${oci_repository_base64}')"
readonly RESULTS_URI="$(decode '${results_uri_base64}')"
readonly RUN_SPEC_BUCKET="$(decode '${run_spec_bucket_base64}')"
readonly RUN_SPEC_KEY="$(decode '${run_spec_key_base64}')"
readonly RUN_SPEC_OBJECT_VERSION="$(decode '${run_spec_object_version_base64}')"
readonly RUN_SPEC_SHA256="$(decode '${run_spec_sha256_base64}')"
readonly RUN_SPEC_URI="$(decode '${run_spec_uri_base64}')"
readonly LOCAL_RECEIPT_PATH="/var/lib/ml-runner/private-receipt/execution-receipt.local.json"
readonly MAXIMUM_BOOTSTRAP_LOG_BYTES=1048576

finalize() {
  local exit_code=$?
  local bounded_log_path="/tmp/ml-runner-bootstrap.tail.$$"

  mark_evidence_failure() {
    if [[ "$exit_code" -eq 0 ]]; then
      exit_code=74
    fi
  }

  trap - EXIT
  set +e

  if [[ -x /usr/bin/aws ]]; then
    if [[ -f "$LOCAL_RECEIPT_PATH" ]]; then
      if ! /usr/bin/aws s3api put-object \
        --region "$AWS_REGION_VALUE" \
        --bucket "$RUN_SPEC_BUCKET" \
        --key "$LOCAL_RECEIPT_KEY" \
        --body "$LOCAL_RECEIPT_PATH" \
        --if-none-match '*' >/dev/null; then
        printf 'aws-runner: local receipt handoff failed\n' >&2
        mark_evidence_failure
      fi
    elif [[ "$exit_code" -eq 0 ]]; then
      printf 'aws-runner: successful guest execution produced no local receipt\n' >&2
      mark_evidence_failure
    fi
  elif [[ "$exit_code" -eq 0 ]]; then
    printf 'aws-runner: successful guest execution cannot publish evidence without AWS CLI\n' >&2
    mark_evidence_failure
  fi

  if [[ -x /usr/bin/aws && -x /usr/bin/tail ]]; then
    if ! /usr/bin/tail --bytes="$MAXIMUM_BOOTSTRAP_LOG_BYTES" \
      /var/log/ml-runner-bootstrap.log >"$bounded_log_path"; then
      printf 'aws-runner: bounded bootstrap log creation failed\n' >&2
      mark_evidence_failure
    elif ! /usr/bin/aws s3 cp \
        --region "$AWS_REGION_VALUE" \
        --only-show-errors \
        "$bounded_log_path" \
        "$LOG_URI"; then
      printf 'aws-runner: bounded bootstrap log upload failed\n' >&2
      mark_evidence_failure
    fi
    /usr/bin/rm -f -- "$bounded_log_path"
  elif [[ "$exit_code" -eq 0 ]]; then
    printf 'aws-runner: successful guest execution cannot persist its bounded bootstrap log\n' >&2
    mark_evidence_failure
  fi

  /usr/bin/sync || true
  /sbin/shutdown -h now || true
  exit "$exit_code"
}

trap finalize EXIT

for service_name in amazon-ssm-agent docker; do
  /usr/bin/systemctl enable --now "$service_name"
done

for executable in /usr/bin/aws /usr/bin/base64 /usr/bin/docker /usr/bin/sha256sum /usr/bin/systemctl /usr/bin/tail; do
  [[ -x "$executable" ]] || {
    printf 'aws-runner: required executable is missing: %s\n' "$executable" >&2
    exit 69
  }
done

/usr/bin/install -d -m 0700 /opt/ml-runner /var/lib/ml-runner/private-receipt
printf '%s' '${guest_runner_script_base64}' | /usr/bin/base64 --decode >/opt/ml-runner/guest-runner.sh
printf '%s' '${deadline_marker_script_base64}' | /usr/bin/base64 --decode >/opt/ml-runner/deadline-marker.sh
/usr/bin/chmod 0700 /opt/ml-runner/guest-runner.sh /opt/ml-runner/deadline-marker.sh

/usr/bin/aws s3api get-object \
  --region "$AWS_REGION_VALUE" \
  --bucket "$RUN_SPEC_BUCKET" \
  --key "$RUN_SPEC_KEY" \
  --version-id "$RUN_SPEC_OBJECT_VERSION" \
  /opt/ml-runner/run-spec.json >/dev/null

printf '%s  %s\n' "$RUN_SPEC_SHA256" /opt/ml-runner/run-spec.json | /usr/bin/sha256sum --check --strict

readonly ECR_REGISTRY="$${OCI_REPOSITORY%%/*}"
/usr/bin/aws ecr get-login-password --region "$AWS_REGION_VALUE" |
  /usr/bin/docker login --username AWS --password-stdin "$ECR_REGISTRY" >/dev/null

export ML_DEPLOYMENT_ID="$DEPLOYMENT_ID"
export ML_OCI_REPOSITORY="$OCI_REPOSITORY"
export ML_OCI_DIGEST="$OCI_DIGEST"
export ML_RUN_SPEC_URI="$RUN_SPEC_URI"
export ML_RUN_SPEC_SHA256="$RUN_SPEC_SHA256"
export ML_RUN_SPEC_OBJECT_VERSION="$RUN_SPEC_OBJECT_VERSION"
export ML_DATA_URI="$DATA_URI"
export ML_RESULTS_URI="$RESULTS_URI"
export ML_CLOUD_PROVIDER="aws"
export ML_MAX_RUNTIME_MINUTES="$MAXIMUM_RUNTIME_MINUTES"
export ML_CONTAINER_RUNTIME_PATH="/usr/bin/docker"
export ML_RECEIPT_OUTPUT_DIRECTORY="/var/lib/ml-runner/private-receipt"

set +e
/opt/ml-runner/guest-runner.sh
guest_exit_code=$?
set -e
exit "$guest_exit_code"
