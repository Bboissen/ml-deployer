${jsonencode({
  Version = "2012-10-17"
  Statement = concat([
    {
      Sid = "ReadDatasetAndOwnOutputVersions"
      Effect = "Allow"
      Action = ["s3:GetObject", "s3:GetObjectVersion"]
      Resource = ["${bucket_arn}/${data_prefix}*", "${bucket_arn}/${output_prefix}*"]
    },
    {
      Sid = "WriteOwnOutputAndMultipart"
      Effect = "Allow"
      Action = ["s3:PutObject", "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"]
      Resource = ["${bucket_arn}/${output_prefix}*"]
    },
    {
      Sid = "ListOnlyReviewedPrefixes"
      Effect = "Allow"
      Action = ["s3:ListBucket", "s3:ListBucketVersions"]
      Resource = [bucket_arn]
      Condition = { StringLike = { "s3:prefix" = ["${data_prefix}*", "${output_prefix}*"] } }
    },
    {
      Sid = "ReadWorkloadBucketLocation"
      Effect = "Allow"
      Action = ["s3:GetBucketLocation"]
      Resource = [bucket_arn]
    },
    {
      Sid = "DenyStateStorage"
      Effect = "Deny"
      Action = ["s3:*"]
      Resource = [state_bucket_arn, "${state_bucket_arn}/*"]
    },
    {
      Sid = "DenyOutsideWorkloadScope"
      Effect = "Deny"
      Action = ["s3:*"]
      NotResource = [bucket_arn, "${bucket_arn}/${data_prefix}*", "${bucket_arn}/${output_prefix}*"]
    },
    {
      Sid = "DenyWritesOutsideOwnOutput"
      Effect = "Deny"
      Action = ["s3:PutObject", "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"]
      NotResource = ["${bucket_arn}/${output_prefix}*"]
    },
    {
      Sid = "DenyUnscopedListing"
      Effect = "Deny"
      Action = ["s3:ListBucket", "s3:ListBucketVersions"]
      Resource = [bucket_arn]
      Condition = { StringNotLike = { "s3:prefix" = ["${data_prefix}*", "${output_prefix}*"] } }
    },
    {
      Sid = "DenyInsecureTransport"
      Effect = "Deny"
      Action = ["s3:*"]
      Resource = ["*"]
      Condition = { Bool = { "aws:SecureTransport" = "false" } }
    },
    {
      Sid = "DenyOtherActionsIncludingDeletionAndAdministration"
      Effect = "Deny"
      NotAction = concat([
        "s3:GetObject", "s3:GetObjectVersion", "s3:PutObject", "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts", "s3:ListBucket", "s3:ListBucketVersions", "s3:GetBucketLocation",
      ], management_actions)
      Resource = ["*"]
    },
  ], include_management ? [
    {
      Sid = "MinimalSessionManagerChannels"
      Effect = "Allow"
      Action = management_actions
      Resource = ["*"]
    },
  ] : [])
})}
