{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "profile_name", "execution_mode", "instance_type", "architecture",
      "purchase_model", "ami_parameter_name", "root_volume_type",
      "root_volume_size_gb", "root_volume_iops", "root_volume_throughput",
      "workspace_volume_enabled", "workspace_volume_type",
      "workspace_volume_size_gb", "workspace_volume_iops",
      "workspace_volume_throughput", "workspace_preserve_on_replacement",
      "delete_workspace_on_terminal_state", "checkpoint_mode",
      "checkpoint_interval_seconds", "s3_backup_interval_seconds",
      "max_recovery_attempts", "recovery_deadline_minutes",
      "associate_public_ipv4", "max_run_duration_minutes",
      "deadline_schedule_enabled", "local_termination_fallback_enabled",
      "allow_ray", "allow_gpu", "accelerator_count",
      "required_min_memory_gb", "max_estimated_cost", "status", "tags"
    ],
    "properties": {
      "profile_name": {"type": "string", "minLength": 1},
      "execution_mode": {"enum": ["DIRECT_INSTANCE", "SPOT_SINGLE_AZ_ASG"]},
      "instance_type": {"type": "string", "minLength": 1},
      "architecture": {"enum": ["x86_64", "arm64"]},
      "purchase_model": {"enum": ["ON_DEMAND", "SPOT"]},
      "ami_parameter_name": {"type": "string", "pattern": "^/aws/service/"},
      "root_volume_type": {"enum": ["gp3"]},
      "root_volume_size_gb": {"type": "integer", "minimum": 8},
      "root_volume_iops": {"type": "integer", "minimum": 3000},
      "root_volume_throughput": {"type": "integer", "minimum": 125},
      "workspace_volume_enabled": {"type": "boolean"},
      "workspace_volume_type": {"enum": ["gp3"]},
      "workspace_volume_size_gb": {"type": "integer", "minimum": 0},
      "workspace_volume_iops": {"type": "integer", "minimum": 3000},
      "workspace_volume_throughput": {"type": "integer", "minimum": 125},
      "workspace_preserve_on_replacement": {"type": "boolean"},
      "delete_workspace_on_terminal_state": {"const": true},
      "checkpoint_mode": {"enum": ["NONE", "JOB_BOUNDARY", "MID_MODEL"]},
      "checkpoint_interval_seconds": {"type": "integer", "minimum": 0},
      "s3_backup_interval_seconds": {"type": "integer", "minimum": 0},
      "max_recovery_attempts": {"type": "integer", "minimum": 0},
      "recovery_deadline_minutes": {"type": "integer", "minimum": 0},
      "associate_public_ipv4": {"type": "boolean"},
      "max_run_duration_minutes": {"type": "integer", "minimum": 1},
      "deadline_schedule_enabled": {"const": true},
      "local_termination_fallback_enabled": {"const": true},
      "allow_ray": {"const": false},
      "allow_gpu": {"type": "boolean"},
      "accelerator_count": {"type": "integer", "minimum": 0},
      "required_min_memory_gb": {"type": "integer", "minimum": 1},
      "max_estimated_cost": {"type": ["number", "null"], "minimum": 0},
      "status": {"enum": ["DISCOVERY_REQUIRED", "PLAN_ONLY"]},
      "tags": {
        "type": "object",
        "required": ["project", "environment", "managed_by", "data_class"],
        "additionalProperties": {"type": "string"}
      }
    }
  }
}
