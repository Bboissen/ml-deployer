# Inactive example. Activating and migrating this backend is a separate,
# reviewed, human-gated commit after the state bucket exists.
terraform {
  backend "s3" {
    endpoints = {
      s3 = "https://ams3.digitaloceanspaces.com"
    }

    bucket = "REPLACE_WITH_STATE_BUCKET"
    key    = "ray-terraform/storage/terraform.tfstate"
    region = "us-east-1"

    skip_credentials_validation = true
    skip_requesting_account_id  = true
    skip_metadata_api_check     = true
    skip_region_validation      = true
    skip_s3_checksum            = true
    use_lockfile                = true
  }
}
