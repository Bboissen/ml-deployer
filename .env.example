# Copy to .env and edit locally. Do not commit .env.

# DigitalOcean
export DIGITALOCEAN_TOKEN=""
export TF_VAR_do_token="$DIGITALOCEAN_TOKEN"
export TF_VAR_region="ams3"
export TF_VAR_size="s-1vcpu-512mb-10gb"
export TF_VAR_worker_count="1"
export DO_WORKER_COUNT="1"
export TF_VAR_ssh_key_name="your-do-ssh-key-name"
export TF_VAR_admin_public_cidr="YOUR_PUBLIC_IP/32"

# Persistent state, Bronze, and VPC (non-secret names; buckets must be globally unique)
export TF_VAR_state_bucket_name="replace-with-unique-state-bucket"
export TF_VAR_bronze_bucket_name="replace-with-unique-bronze-bucket"
export TF_VAR_vpc_name="demo-data-ams3"
# Fill from `terraform -chdir=terraform/digitalocean-storage output -raw vpc_uuid`
# only after the separately authorized storage apply.
export TF_VAR_vpc_uuid=""
# Fill from `terraform -chdir=terraform/digitalocean-storage output -raw vpc_cidr`.
export TF_VAR_vpc_cidr=""

# Broad bootstrap/provider identity. Keep empty here and set only in local .env.
export SPACES_ACCESS_KEY_ID=""
export SPACES_SECRET_ACCESS_KEY=""
# Separate Bronze-only identity used by the Phase 2 controller. These names are
# deliberately not AWS_* (backend) or SPACES_* (bootstrap/provider).
export BRONZE_SPACES_ACCESS_KEY_ID=""
export BRONZE_SPACES_SECRET_ACCESS_KEY=""
# Separate, state-bucket-scoped identity for the later S3 backend. Never reuse the
# broad bootstrap/provider key for this role.
export AWS_ACCESS_KEY_ID=""
export AWS_SECRET_ACCESS_KEY=""

# Tailscale
# Use a reusable + ephemeral + pre-authorized auth key for disposable workers.
export TS_AUTH_KEY=""
export TF_VAR_tailscale_auth_key="$TS_AUTH_KEY"
export RAY_HEAD_TS_IP="100.x.y.z"
export TF_VAR_ray_head_tailscale_ip="$RAY_HEAD_TS_IP"

# Local lab
export LOCAL_VM_PREFIX="ray-lab-worker"
export WORKER_COUNT="3"
export LOCAL_VM_CPUS="1"
export LOCAL_VM_MEMORY="2G"
export LOCAL_VM_DISK="12G"

# Ray
export RAY_HEAD_PORT="6379"
export RAY_DASHBOARD_PORT="8265"
export RAY_CLIENT_PORT="10001"
export RAY_MIN_WORKER_PORT="10002"
export RAY_MAX_WORKER_PORT="10100"
export RAY_OBJECT_STORE_MEMORY="268435456"
export TF_VAR_ray_object_store_memory="80000000"
# Keep the home server as an orchestrator by default. Set >0 to let it run trials too.
export RAY_HEAD_CPUS="0"

# Phase 2 non-secret cache bounds. Live authorization remains a one-use ignored
# mode-0600 receipt, never an environment flag.
export DEMO_CACHE_ROOT="/data/demo-cache"
export DEMO_CACHE_LIMIT_BYTES="21474836480"
export DEMO_RAY_WORKSPACE_BYTES="4294967296"

# Optional Codex/subagent hook.
# This command receives the latest markdown report path as the last argument.
# Example: export CODEX_REVIEW_COMMAND="codex exec --"
export CODEX_REVIEW_COMMAND=""

# GCP single-node path (non-secret fixed values)
export GCP_PROJECT_ID="example-project"
export GCP_REGION="us-central1"
export GCP_ZONE="us-central1-a"
export GCP_STATE_BUCKET="example-project-tofu-state"
export GCP_BRONZE_BUCKET="example-project-bronze"
export GCP_SILVER_BUCKET="example-project-silver"
export GCP_ARTIFACT_BUCKET="example-project-artifacts"
export GCP_ADMIN_EMAIL=""
export GCP_BILLING_ACCOUNT_ID=""
export GCP_TOFU_DEPLOYER_SERVICE_ACCOUNT="tofu-deployer@example-project.iam.gserviceaccount.com"
export GCP_DATA_PUBLISHER_SERVICE_ACCOUNT="data-publisher@example-project.iam.gserviceaccount.com"
export GCP_TRAINING_SERVICE_ACCOUNT="training-runtime@example-project.iam.gserviceaccount.com"
export GCP_SUBNETWORK_SELF_LINK=""
export GCP_MAX_AUTHORIZED_COST="10"
export GCP_MAX_RUNTIME_MINUTES="45"
export GOOGLE_BACKEND_IMPERSONATE_SERVICE_ACCOUNT="$GCP_TOFU_DEPLOYER_SERVICE_ACCOUNT"
export GOOGLE_IMPERSONATE_SERVICE_ACCOUNT="$GCP_TOFU_DEPLOYER_SERVICE_ACCOUNT"
