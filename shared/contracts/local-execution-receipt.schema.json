{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ray-terraform.invalid/contracts/local-execution-receipt.schema.json",
  "title": "Local guest execution receipt",
  "description": "Atomic local outcome consumed by a provider uploader. It is not evidence that cloud upload or provider-side deadline verification succeeded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_kind",
    "execution_terminal",
    "deployment_id",
    "provider",
    "oci_repository",
    "oci_digest",
    "run_spec_uri",
    "run_spec_sha256",
    "run_spec_object_version",
    "data_uri",
    "results_uri",
    "maximum_runtime_minutes",
    "started_at_utc",
    "finished_at_utc",
    "status",
    "container_exit_code"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "receipt_kind": {"const": "local_execution"},
    "execution_terminal": {"const": true},
    "deployment_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 48,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{1,46}[a-z0-9])$"
    },
    "provider": {"enum": ["aws", "gcp", "azure"]},
    "oci_repository": {
      "type": "string",
      "minLength": 3,
      "maxLength": 255,
      "pattern": "^[a-z0-9][a-z0-9.-]*(?::[0-9]+)?(?:/[a-z0-9]+(?:[._-][a-z0-9]+)*)+$"
    },
    "oci_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "run_spec_uri": {
      "type": "string",
      "minLength": 8,
      "maxLength": 2048,
      "pattern": "^(?:s3|gs|https)://[^?#\\s]+/run-specs/[a-z0-9](?:[a-z0-9-]{1,46}[a-z0-9])/[0-9a-f]{64}\\.json$"
    },
    "run_spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "run_spec_object_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u0020\\u007F]+$"
    },
    "data_uri": {"type": "string", "minLength": 5, "maxLength": 2048, "pattern": "^(?:s3|gs|https)://[^?#\\s]+/$"},
    "results_uri": {
      "type": "string",
      "minLength": 5,
      "maxLength": 2048,
      "pattern": "^(?:s3|gs|https)://[^?#\\s]+/runs/[a-z0-9](?:[a-z0-9-]{1,46}[a-z0-9])/results/$"
    },
    "maximum_runtime_minutes": {"type": "integer", "minimum": 15, "maximum": 720},
    "started_at_utc": {"type": "string", "format": "date-time"},
    "finished_at_utc": {"type": "string", "format": "date-time"},
    "status": {"enum": ["succeeded", "failed", "timed_out"]},
    "container_exit_code": {"type": "integer", "minimum": 0, "maximum": 255}
  },
  "allOf": [
    {
      "if": {"properties": {"provider": {"const": "aws"}}, "required": ["provider"]},
      "then": {
        "properties": {
          "oci_repository": {"pattern": "^[0-9]{12}\\.dkr\\.ecr\\.[a-z0-9-]+\\.amazonaws\\.com/"},
          "run_spec_uri": {"pattern": "^s3://"},
          "data_uri": {"pattern": "^s3://"},
          "results_uri": {"pattern": "^s3://"}
        }
      }
    },
    {
      "if": {"properties": {"provider": {"const": "gcp"}}, "required": ["provider"]},
      "then": {
        "properties": {
          "oci_repository": {"pattern": "^[a-z0-9-]+-docker\\.pkg\\.dev/"},
          "run_spec_uri": {"pattern": "^gs://"},
          "data_uri": {"pattern": "^gs://"},
          "results_uri": {"pattern": "^gs://"}
        }
      }
    },
    {
      "if": {"properties": {"provider": {"const": "azure"}}, "required": ["provider"]},
      "then": {
        "properties": {
          "oci_repository": {"pattern": "^[a-z0-9]{5,50}\\.azurecr\\.io/"},
          "run_spec_uri": {"pattern": "^https://[a-z0-9]{3,24}\\.blob\\.core\\.windows\\.net/"},
          "data_uri": {"pattern": "^https://[a-z0-9]{3,24}\\.blob\\.core\\.windows\\.net/"},
          "results_uri": {"pattern": "^https://[a-z0-9]{3,24}\\.blob\\.core\\.windows\\.net/"}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "succeeded"}}},
      "then": {"properties": {"container_exit_code": {"const": 0}}},
      "else": {"properties": {"container_exit_code": {"not": {"const": 0}}}}
    },
    {
      "if": {"properties": {"status": {"const": "timed_out"}}, "required": ["status"]},
      "then": {"properties": {"container_exit_code": {"const": 124}}}
    }
  ]
}
