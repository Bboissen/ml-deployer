{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ray-terraform.invalid/contracts/result-manifest.schema.json",
  "$comment": "Structural schema. validate-result-manifest.sh additionally enforces sorted unique safe paths and the aggregate size bound.",
  "title": "Canonical workload result manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workload",
    "run_spec_sha256",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "workload": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{1,62}[a-z0-9])$"
    },
    "run_spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "content_type", "bytes", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
          },
          "content_type": {
            "type": "string",
            "minLength": 3,
            "maxLength": 127,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]*/[A-Za-z0-9][A-Za-z0-9.+-]*$"
          },
          "bytes": {"type": "integer", "minimum": 1, "maximum": 1073741824},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
