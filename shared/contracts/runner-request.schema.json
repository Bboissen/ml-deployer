{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ray-terraform.invalid/contracts/runner-request.schema.json",
  "$comment": "Structural schema. validate-runner-request.sh is additionally required for sibling-field URI binding and profile semantics.",
  "title": "Cross-cloud runner request",
  "description": "Provider-neutral request for exactly one disposable runner state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "deployment_id",
    "provider",
    "oci_repository",
    "oci_digest",
    "run_spec_uri",
    "run_spec_sha256",
    "run_spec_object_version",
    "resource_profile",
    "capacity_mode",
    "maximum_runtime_minutes"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "deployment_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 48,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{1,46}[a-z0-9])$"
    },
    "provider": {
      "enum": [
        "aws",
        "gcp",
        "azure"
      ]
    },
    "oci_repository": {
      "description": "Provider-local OCI repository without a tag or digest.",
      "type": "string",
      "minLength": 3,
      "maxLength": 255,
      "pattern": "^[a-z0-9][a-z0-9.-]*(?::[0-9]+)?(?:/[a-z0-9]+(?:[._-][a-z0-9]+)*)+$"
    },
    "oci_digest": {
      "description": "Canonical digest that must identify the same artifact on every provider-local repository.",
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "run_spec_uri": {
      "description": "Provider-local immutable object URI. The object content remains opaque to this repository.",
      "type": "string",
      "minLength": 8,
      "maxLength": 2048,
      "pattern": "^(?:s3|gs|https)://[^?#\\s]+/run-specs/[a-z0-9](?:[a-z0-9-]{1,46}[a-z0-9])/[a-f0-9]{64}\\.json$"
    },
    "run_spec_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "run_spec_object_version": {
      "description": "Provider-native immutable object version or generation identifier.",
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u0020\\u007F]+$"
    },
    "resource_profile": {
      "enum": [
        "smoke",
        "balanced",
        "highmem"
      ]
    },
    "capacity_mode": {
      "description": "Interruptible capacity remains disabled until checkpoint recovery is separately accepted.",
      "const": "standard"
    },
    "maximum_runtime_minutes": {
      "type": "integer",
      "minimum": 15,
      "maximum": 720
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "provider": {
            "const": "aws"
          }
        },
        "required": [
          "provider"
        ]
      },
      "then": {
        "properties": {
          "oci_repository": {
            "pattern": "^[0-9]{12}\\.dkr\\.ecr\\.[a-z0-9-]+\\.amazonaws\\.com(?:/[a-z0-9]+(?:[._-][a-z0-9]+)*)+$"
          },
          "run_spec_uri": {
            "pattern": "^s3://[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]/[^?#\\s]+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provider": {
            "const": "gcp"
          }
        },
        "required": [
          "provider"
        ]
      },
      "then": {
        "properties": {
          "oci_repository": {
            "pattern": "^[a-z0-9-]+-docker\\.pkg\\.dev/[a-z0-9-]+(?:/[a-z0-9]+(?:[._-][a-z0-9]+)*){2,}$"
          },
          "run_spec_uri": {
            "pattern": "^gs://[a-z0-9][a-z0-9._-]{1,220}/[^?#\\s]+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provider": {
            "const": "azure"
          }
        },
        "required": [
          "provider"
        ]
      },
      "then": {
        "properties": {
          "oci_repository": {
            "pattern": "^[a-z0-9]{5,50}\\.azurecr\\.io(?:/[a-z0-9]+(?:[._-][a-z0-9]+)*)+$"
          },
          "run_spec_uri": {
            "pattern": "^https://[a-z0-9]{3,24}\\.blob\\.core\\.windows\\.net/[a-z0-9](?:[a-z0-9-]{1,61}[a-z0-9])?/[^?#\\s]+$"
          }
        }
      }
    }
  ]
}
