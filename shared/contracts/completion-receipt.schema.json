{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ray-terraform.invalid/contracts/completion-receipt.schema.json",
  "$comment": "Structural schema. validate-completion-receipt.sh and provider-authenticated publication metadata are additionally required.",
  "title": "Cross-cloud completion receipt",
  "description": "Terminal receipt created conditionally by a provider control identity outside the workload-writable namespace.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "terminal",
    "deployment_id",
    "provider",
    "account_scope",
    "region",
    "backend_key",
    "request_sha256",
    "platform_contract_sha256",
    "runner_id",
    "workload_identity",
    "receipt_publisher_identity",
    "receipt_uri",
    "publication_mode",
    "control_evidence_uri",
    "control_evidence_sha256",
    "oci_repository",
    "oci_digest",
    "run_spec_uri",
    "run_spec_sha256",
    "run_spec_object_version",
    "resource_profile",
    "resolved_machine_type",
    "resolved_vcpu",
    "resolved_memory_mib",
    "capacity_mode",
    "maximum_runtime_minutes",
    "started_at",
    "deadline",
    "finished_at",
    "status",
    "container_exit_code",
    "results_uri",
    "log_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "terminal": {"const": true},
    "deployment_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 48,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{1,46}[a-z0-9])$"
    },
    "provider": {"enum": ["aws", "gcp", "azure"]},
    "account_scope": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
    },
    "region": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "backend_key": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^(aws|gcp|azure)/[A-Za-z0-9._-]+/[a-z0-9-]+/runner/[a-z0-9](?:[a-z0-9-]{1,46}[a-z0-9])\\.tfstate$"
    },
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "platform_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runner_id": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000-\\u001F\\u007F]+$"},
    "workload_identity": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000-\\u001F\\u007F]+$"},
    "receipt_publisher_identity": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000-\\u001F\\u007F]+$"},
    "receipt_uri": {
      "type": "string",
      "minLength": 8,
      "maxLength": 2048,
      "pattern": "^(?:s3|gs|https)://[^?#\\s]+/control/receipts/[a-z0-9](?:[a-z0-9-]{1,46}[a-z0-9])/completion\\.v1\\.json$"
    },
    "publication_mode": {"const": "control_identity_conditional_create"},
    "control_evidence_uri": {
      "type": "string",
      "minLength": 8,
      "maxLength": 2048,
      "pattern": "^(?:s3|gs|https)://[^?#\\s]+/control/evidence/[a-z0-9](?:[a-z0-9-]{1,46}[a-z0-9])/[a-f0-9]{64}\\.json$"
    },
    "control_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "local_execution_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "oci_repository": {
      "type": "string",
      "minLength": 3,
      "maxLength": 255,
      "pattern": "^[a-z0-9][a-z0-9.-]*(?::[0-9]+)?(?:/[a-z0-9]+(?:[._-][a-z0-9]+)*)+$"
    },
    "oci_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "run_spec_uri": {
      "type": "string",
      "minLength": 8,
      "maxLength": 2048,
      "pattern": "^(?:s3|gs|https)://[^?#\\s]+/run-specs/[a-z0-9](?:[a-z0-9-]{1,46}[a-z0-9])/[a-f0-9]{64}\\.json$"
    },
    "run_spec_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "run_spec_object_version": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000-\\u0020\\u007F]+$"},
    "resource_profile": {"enum": ["smoke", "balanced", "highmem"]},
    "resolved_machine_type": {"type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[^\\u0000-\\u001F\\u007F]+$"},
    "resolved_vcpu": {"type": "integer", "minimum": 1},
    "resolved_memory_mib": {"type": "integer", "minimum": 1},
    "capacity_mode": {"const": "standard"},
    "maximum_runtime_minutes": {"type": "integer", "minimum": 15, "maximum": 720},
    "started_at": {"type": "string", "format": "date-time"},
    "deadline": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["succeeded", "failed", "timed_out", "interrupted", "bootstrap_failed"]},
    "container_exit_code": {"type": "integer", "minimum": -1, "maximum": 255},
    "results_uri": {
      "type": "string",
      "minLength": 8,
      "maxLength": 2048,
      "pattern": "^(?:s3|gs|https)://[^?#\\s]+/runs/[a-z0-9](?:[a-z0-9-]{1,46}[a-z0-9])/results/$"
    },
    "result_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "log_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"provider": {"const": "aws"}}, "required": ["provider"]},
      "then": {
        "properties": {
          "oci_repository": {"pattern": "^[0-9]{12}\\.dkr\\.ecr\\.[a-z0-9-]+\\.amazonaws\\.com/"},
          "run_spec_uri": {"pattern": "^s3://"},
          "results_uri": {"pattern": "^s3://"},
          "receipt_uri": {"pattern": "^s3://"},
          "control_evidence_uri": {"pattern": "^s3://"}
        }
      }
    },
    {
      "if": {"properties": {"provider": {"const": "gcp"}}, "required": ["provider"]},
      "then": {
        "properties": {
          "oci_repository": {"pattern": "^[a-z0-9-]+-docker\\.pkg\\.dev/"},
          "run_spec_uri": {"pattern": "^gs://"},
          "results_uri": {"pattern": "^gs://"},
          "receipt_uri": {"pattern": "^gs://"},
          "control_evidence_uri": {"pattern": "^gs://"}
        }
      }
    },
    {
      "if": {"properties": {"provider": {"const": "azure"}}, "required": ["provider"]},
      "then": {
        "properties": {
          "oci_repository": {"pattern": "^[a-z0-9]{5,50}\\.azurecr\\.io/"},
          "run_spec_uri": {"pattern": "^https://[a-z0-9]{3,24}\\.blob\\.core\\.windows\\.net/"},
          "results_uri": {"pattern": "^https://[a-z0-9]{3,24}\\.blob\\.core\\.windows\\.net/"},
          "receipt_uri": {"pattern": "^https://[a-z0-9]{3,24}\\.blob\\.core\\.windows\\.net/"},
          "control_evidence_uri": {"pattern": "^https://[a-z0-9]{3,24}\\.blob\\.core\\.windows\\.net/"}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "succeeded"}}, "required": ["status"]},
      "then": {
        "properties": {"container_exit_code": {"const": 0}},
        "required": ["result_manifest_sha256"]
      }
    },
    {
      "if": {"properties": {"status": {"const": "bootstrap_failed"}}, "required": ["status"]},
      "then": {"properties": {"container_exit_code": {"const": -1}}}
    },
    {
      "if": {"properties": {"status": {"const": "timed_out"}}, "required": ["status"]},
      "then": {"properties": {"container_exit_code": {"const": 124}}}
    },
    {
      "if": {"properties": {"status": {"enum": ["failed", "interrupted"]}}, "required": ["status"]},
      "then": {"properties": {"container_exit_code": {"minimum": 1}}}
    },
    {
      "if": {
        "properties": {"status": {"enum": ["succeeded", "failed", "timed_out"]}},
        "required": ["status"]
      },
      "then": {"required": ["local_execution_receipt_sha256"]}
    },
    {
      "if": {"properties": {"status": {"const": "bootstrap_failed"}}, "required": ["status"]},
      "then": {
        "allOf": [
          {"not": {"required": ["local_execution_receipt_sha256"]}},
          {"not": {"required": ["result_manifest_sha256"]}}
        ]
      }
    }
  ]
}
