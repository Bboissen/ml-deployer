{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ml-deployer.invalid/workspace/project/1.0.0/schema.json",
  "$comment": "Configuration preparation only. AWS controller enforces source/ref/path and supported-profile semantics. Existing workspace 2.0.0 records are unchanged.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provider", "profile", "region", "project", "workspace", "dataset", "repository", "commands", "outputs", "resources", "maximum_runtime_minutes"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "provider": {"enum": ["aws"]},
    "profile": {"type": "string", "pattern": "^[A-Za-z0-9_+=,.@-]{1,128}$"},
    "region": {"type": "string", "pattern": "^[a-z]{2}-[a-z]+-[0-9]+$"},
    "project": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,22}[a-z0-9]$"},
    "workspace": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 24},
    "mode": {"enum": ["job", "workspace"], "default": "job"},
    "dataset": {
      "type": "object", "additionalProperties": false, "required": ["source"],
      "properties": {"source": {"$ref": "#/$defs/text"}, "maximum_bytes": {"type": "integer", "minimum": 1, "maximum": 5497558138880}}
    },
    "repository": {
      "type": "object", "additionalProperties": false, "required": ["url", "ref"],
      "properties": {"url": {"$ref": "#/$defs/text"}, "ref": {"$ref": "#/$defs/text"}}
    },
    "commands": {
      "type": "object", "additionalProperties": false, "required": ["setup", "run"],
      "properties": {"setup": {"$ref": "#/$defs/argv"}, "run": {"$ref": "#/$defs/argv"}}
    },
    "outputs": {
      "type": "object", "additionalProperties": false, "required": ["paths"],
      "properties": {"maximum_bytes": {"type": "integer", "minimum": 1, "maximum": 5497558138880}, "paths": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}}
    },
    "resources": {
      "type": "object", "additionalProperties": false, "required": ["policy"],
      "properties": {"policy": {"const": "ram-first"}, "maximum_hourly_usd": {"type": "number", "exclusiveMinimum": 0}, "disk_gb": {"type": "integer", "minimum": 25, "maximum": 2000}}
    },
    "maximum_runtime_minutes": {"type": "integer", "minimum": 15, "maximum": 2880}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^[^\\x00-\\x1f\\x7f]+$"},
    "argv": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/text"}}
  }
}
