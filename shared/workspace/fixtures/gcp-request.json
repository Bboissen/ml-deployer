{
  "schema_version": "2.0.0",
  "provider": "gcp",
  "account_scope": "example-project",
  "region": "europe-west1",
  "workspace_id": "workspace-example",
  "kind": "request",
  "toolbox_profile": "cpu-python-v1",
  "resources": {
    "cpus": 2,
    "memory_mb": 4096,
    "disk_gb": 20
  },
  "storage": {
    "data_uri": "gs://workspace-data-example/datasets/example/",
    "output_uri": "gs://workspace-data-example/outputs/workspace-example/",
    "state_uri": "gs://workspace-state-example/gcp/runner/example.tfstate"
  },
  "operators": [
    "operator@example.com"
  ],
  "maximum_runtime_minutes": 60
}
