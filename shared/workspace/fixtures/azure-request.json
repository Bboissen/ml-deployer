{
  "schema_version": "2.0.0",
  "provider": "azure",
  "account_scope": "00000000-0000-0000-0000-000000000001",
  "region": "westeurope",
  "workspace_id": "workspace-example",
  "kind": "request",
  "toolbox_profile": "cpu-python-v1",
  "resources": {
    "cpus": 2,
    "memory_mb": 4096,
    "disk_gb": 20
  },
  "storage": {
    "data_uri": "https://workloaddataexample.blob.core.windows.net/data/datasets/example/",
    "output_uri": "https://workloaddataexample.blob.core.windows.net/data/outputs/workspace-example/",
    "state_uri": "https://workspacestateexample.blob.core.windows.net/state/azure/runner/example.tfstate"
  },
  "operators": [
    "operator@example.com"
  ],
  "maximum_runtime_minutes": 60
}
