{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ml-deployer.invalid/workspace/2.0.0/schema.json",
  "$comment": "validate.py additionally enforces binding, native URI, identity, deadline and readiness semantics. No cloud calls.",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/handoff"
    },
    {
      "$ref": "#/$defs/readiness"
    }
  ],
  "$defs": {
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpus",
        "memory_mb",
        "disk_gb"
      ],
      "properties": {
        "cpus": {
          "type": "integer",
          "minimum": 1
        },
        "memory_mb": {
          "type": "integer",
          "minimum": 1024
        },
        "disk_gb": {
          "type": "integer",
          "minimum": 10
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_uri",
        "output_uri",
        "state_uri"
      ],
      "properties": {
        "data_uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "output_uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "state_uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evidence"
      ],
      "properties": {
        "status": {
          "enum": [
            "pass",
            "fail",
            "unverified"
          ]
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "provider",
        "account_scope",
        "region",
        "workspace_id",
        "toolbox_profile",
        "resources",
        "storage",
        "operators",
        "maximum_runtime_minutes"
      ],
      "properties": {
        "schema_version": {
          "const": "2.0.0"
        },
        "kind": {
          "const": "request"
        },
        "provider": {
          "enum": [
            "aws"
          ]
        },
        "account_scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "region": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "workspace_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 48,
          "pattern": "^[a-z0-9][a-z0-9-]{1,46}[a-z0-9]$"
        },
        "toolbox_profile": {
          "const": "cpu-python-v1"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "storage": {
          "$ref": "#/$defs/storage"
        },
        "operators": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          }
        },
        "maximum_runtime_minutes": {
          "type": "integer",
          "minimum": 15,
          "maximum": 2880
        }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "provider",
        "account_scope",
        "region",
        "workspace_id",
        "request_sha256",
        "toolbox_profile",
        "image_reference",
        "bootstrap_sha256",
        "machine_id",
        "user",
        "project_directory",
        "storage",
        "identity",
        "terminal",
        "lifetime"
      ],
      "properties": {
        "schema_version": {
          "const": "2.0.0"
        },
        "kind": {
          "const": "handoff"
        },
        "provider": {
          "enum": [
            "aws"
          ]
        },
        "account_scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "region": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "workspace_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 48,
          "pattern": "^[a-z0-9][a-z0-9-]{1,46}[a-z0-9]$"
        },
        "request_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "toolbox_profile": {
          "const": "cpu-python-v1"
        },
        "image_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "bootstrap_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "machine_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "user": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "project_directory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^/(?:home|workspaces)/[^\\x00-\\x20\\x7f]+$"
        },
        "storage": {
          "$ref": "#/$defs/storage"
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "selector"
          ],
          "properties": {
            "mode": {
              "enum": [
                "instance_role",
                "service_account",
                "managed_identity"
              ]
            },
            "selector": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^[^\\x00-\\x1f\\x7f]+$"
            }
          }
        },
        "terminal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "argv"
          ],
          "properties": {
            "method": {
              "enum": [
                "ssm",
                "iap_oslogin",
                "reviewed_ssh"
              ]
            },
            "argv": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "^[^\\x00-\\x1f\\x7f]+$"
              }
            }
          }
        },
        "lifetime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "started_at",
            "expires_at",
            "guard_active_at",
            "guard_id",
            "expiry_action"
          ],
          "properties": {
            "started_at": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
              "format": "date-time"
            },
            "expires_at": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
              "format": "date-time"
            },
            "guard_active_at": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
              "format": "date-time"
            },
            "guard_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^[^\\x00-\\x1f\\x7f]+$"
            },
            "expiry_action": {
              "enum": [
                "terminate",
                "delete",
                "deallocate"
              ]
            }
          }
        }
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "provider",
        "account_scope",
        "region",
        "workspace_id",
        "request_sha256",
        "handoff_sha256",
        "observed_at",
        "resources",
        "versions",
        "checks"
      ],
      "properties": {
        "schema_version": {
          "const": "2.0.0"
        },
        "kind": {
          "const": "readiness"
        },
        "provider": {
          "enum": [
            "aws"
          ]
        },
        "account_scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "region": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "workspace_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 48,
          "pattern": "^[a-z0-9][a-z0-9-]{1,46}[a-z0-9]$"
        },
        "request_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "handoff_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "observed_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "format": "date-time"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "versions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "git",
            "python",
            "uv",
            "cc",
            "make",
            "storage_cli",
            "storage_sdk"
          ],
          "properties": {
            "git": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "^[^\\x00-\\x1f\\x7f]+$"
            },
            "python": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "^[^\\x00-\\x1f\\x7f]+$"
            },
            "uv": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "^[^\\x00-\\x1f\\x7f]+$"
            },
            "cc": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "^[^\\x00-\\x1f\\x7f]+$"
            },
            "make": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "^[^\\x00-\\x1f\\x7f]+$"
            },
            "storage_cli": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "^[^\\x00-\\x1f\\x7f]+$"
            },
            "storage_sdk": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "^[^\\x00-\\x1f\\x7f]+$"
            }
          }
        },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "toolbox",
            "terminal",
            "identity",
            "storage",
            "state_denied",
            "unrelated_denied",
            "profile",
            "deadline",
            "writable_project"
          ],
          "properties": {
            "toolbox": {
              "$ref": "#/$defs/check"
            },
            "terminal": {
              "$ref": "#/$defs/check"
            },
            "identity": {
              "$ref": "#/$defs/check"
            },
            "storage": {
              "$ref": "#/$defs/check"
            },
            "state_denied": {
              "$ref": "#/$defs/check"
            },
            "unrelated_denied": {
              "$ref": "#/$defs/check"
            },
            "profile": {
              "$ref": "#/$defs/check"
            },
            "deadline": {
              "$ref": "#/$defs/check"
            },
            "writable_project": {
              "$ref": "#/$defs/check"
            }
          }
        }
      }
    }
  }
}
