#cloud-config
hostname: ${worker_hostname}
package_update: true
package_upgrade: false
packages:
  - curl
  - python3-venv
  - python3-pip
  - htop
  - rsync
  - netcat-openbsd
  - ufw

ssh_pwauth: false
disable_root: false

write_files:
  - path: /opt/spotify-ray/configure-vpc-dns.sh
    content: |
      #!/usr/bin/env bash
      set -Eeuo pipefail

      resolver=${vpc_resolver_ip}
      private_ip="$(curl -fsS --max-time 5 http://169.254.169.254/metadata/v1/interfaces/private/0/ipv4/address)"
      mapfile -t private_links < <(ip -o -4 address show | awk -v ip="$private_ip" '$4 ~ ("^" ip "/") {print $2}')
      [[ "$${#private_links[@]}" -eq 1 ]] || {
        printf 'expected one VPC interface for %s, found %s\n' "$private_ip" "$${#private_links[@]}" >&2
        exit 1
      }
      private_link="$${private_links[0]}"

      install -d -m 0755 /etc/systemd/resolved.conf.d
      printf '[Resolve]\nDNS=%s\nFallbackDNS=\n' "$resolver" \
        >/etc/systemd/resolved.conf.d/spotify-ray-vpc.conf
      systemctl restart systemd-resolved
      ln -sfn /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf

      while read -r link; do
        [[ "$link" == "$private_link" || "$link" == lo ]] && continue
        resolvectl dns "$link" ""
        resolvectl domain "$link" ""
        resolvectl default-route "$link" no
      done < <(ip -o link show | awk -F': ' '{print $2}' | cut -d@ -f1)

      resolvectl dns "$private_link" "$resolver"
      resolvectl domain "$private_link" '~.'
      resolvectl default-route "$private_link" yes
      resolvectl flush-caches

      mapfile -t configured < <(
        resolvectl dns "$private_link" | grep -Eo '([0-9]{1,3}\.){3}[0-9]{1,3}' | sort -u
      )
      [[ "$${#configured[@]}" -eq 1 && "$${configured[0]}" == "$resolver" ]] || {
        printf 'VPC resolver verification failed for %s\n' "$private_link" >&2
        exit 1
      }

  - path: /etc/systemd/system/spotify-ray-vpc-dns.service
    content: |
      [Unit]
      Description=Use the DigitalOcean VPC-local DNS resolver exclusively
      After=network-online.target systemd-resolved.service
      Wants=network-online.target systemd-resolved.service
      Before=ray-worker.service

      [Service]
      Type=oneshot
      ExecStart=/opt/spotify-ray/configure-vpc-dns.sh
      RemainAfterExit=yes

      [Install]
      WantedBy=multi-user.target

  - path: /opt/spotify-ray/start-worker.sh
    content: |
      #!/usr/bin/env bash
      set -euxo pipefail
      source /opt/spotify-ray/venv/bin/activate

      for i in $(seq 1 180); do
        TS_IP="$(tailscale ip -4 2>/dev/null | head -n1 || true)"
        if [ -n "$TS_IP" ] && nc -z ${ray_head_tailscale_ip} 6379; then
          break
        fi
        sleep 2
      done

      TS_IP="$(tailscale ip -4 | head -n1)"
      ray stop --force || true
      ray start \
        --address="${ray_head_tailscale_ip}:6379" \
        --node-ip-address="$TS_IP" \
        --min-worker-port=10002 \
        --max-worker-port=10100 \
        --node-manager-port=11001 \
        --object-manager-port=11002 \
        --runtime-env-agent-port=11003 \
        --dashboard-agent-listen-port=11004 \
        --metrics-export-port=11005 \
        --object-store-memory=${ray_object_store_memory}
      tail -f /dev/null

  - path: /etc/systemd/system/ray-worker.service
    content: |
      [Unit]
      Description=Ray worker over Tailscale
      After=network-online.target tailscaled.service spotify-ray-vpc-dns.service
      Wants=network-online.target tailscaled.service spotify-ray-vpc-dns.service

      [Service]
      Type=simple
      Restart=always
      RestartSec=10
      ExecStart=/opt/spotify-ray/start-worker.sh

      [Install]
      WantedBy=multi-user.target

runcmd:
  - mkdir -p /opt/spotify-ray /data/tune /artifacts
  - curl -fsSL https://tailscale.com/install.sh | sh
  - tailscale up --auth-key="${tailscale_auth_key}" --hostname="${worker_hostname}" --ssh=false --accept-dns=false --accept-routes=false
  - curl -LsSf https://astral.sh/uv/install.sh | UV_INSTALL_DIR=/usr/local/bin sh
  - /usr/local/bin/uv python install 3.14.4
  - /usr/local/bin/uv venv --python 3.14.4 /opt/spotify-ray/venv
  - /usr/local/bin/uv pip install --python /opt/spotify-ray/venv/bin/python -U pip wheel
  - /usr/local/bin/uv pip install --python /opt/spotify-ray/venv/bin/python "ray[client,default,tune]==2.56.0" psutil PyYAML
  - ufw default deny incoming
  - ufw default allow outgoing
  - ufw allow 22/tcp
  - ufw allow in on tailscale0 to any port 22 proto tcp
  - ufw allow in on tailscale0 to any port 10002:10100 proto tcp
  - ufw allow in on tailscale0 to any port 11001:11005 proto tcp
  - ufw --force enable
  - chmod 0755 /opt/spotify-ray/configure-vpc-dns.sh /opt/spotify-ray/start-worker.sh
  - systemctl daemon-reload
  - systemctl enable --now spotify-ray-vpc-dns.service
  - systemctl enable --now ray-worker.service
